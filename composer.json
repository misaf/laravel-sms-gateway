{
	"name": "misaf/laravel-sms-gateway",
	"description": "Supercharge your Laravel applications with our seamless SMS Gateway integration!",
	"keywords": [
		"laravel",
		"sms",
		"gateway",
		"messaging",
		"notification",
		"alerts",
		"integration"
	],
	"homepage": "https://github.com/misaf/sms-gateway",
	"support": {
		"issues": "https://github.com/misaf/laravel-sms-gateway/issues",
		"source": "https://github.com/misaf/laravel-sms-gateway"
	},
	"license": "MIT",
	"authors": [
		{
			"name": "Ehsan Mahmoodi",
			"email": "misaf.1990@gmail.com"
		}
	],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
		"guzzlehttp/guzzle": "^7.10",
		"laravel/pint": "^1.27.0",
		"nunomaduro/collision": "^8.8.3",
		"pestphp/pest-plugin-arch": "^4.0",
		"pestphp/pest-plugin-laravel": "^4.0",
		"pestphp/pest-plugin-type-coverage": "^4.0.3",
		"phpstan/extension-installer": "^1.4.3",
		"phpstan/phpstan-deprecation-rules": "^2.0.3",
		"phpstan/phpstan-phpunit": "^2.0.12",
        "pestphp/pest": "^4.3.1",
        "orchestra/testbench": "^10.9"
    },
    "scripts": {
        "test": "pest"
    },
	"autoload": {
		"psr-4": {
			"Misaf\\LaravelSmsGateway\\": "src/",
            "Misaf\\LaravelSmsGateway\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Misaf\\LaravelSmsGateway\\SmsGatewayServiceProvider"
			]
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"phpstan/extension-installer": true
		}
	}
}
