{
	"name": "misaf/laravel-sms-gateway",
	"description": "Supercharge your Laravel applications with our seamless SMS Gateway integration!",
	"keywords": [
		"laravel",
		"sms",
		"gateway",
		"messaging",
		"notification",
		"alerts",
		"integration"
	],
	"homepage": "https://github.com/misaf/sms-gateway",
	"support": {
		"issues": "https://github.com/misaf/laravel-sms-gateway/issues",
		"source": "https://github.com/misaf/laravel-sms-gateway"
	},
	"license": "MIT",
	"authors": [
		{
			"name": "Ehsan Mahmoodi",
			"email": "misaf.1990@gmail.com"
		}
	],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
		"illuminate/support": "^10.0",
		"guzzlehttp/guzzle": "^7.8.1",
		"laravel/pint": "^1.16.0",
		"nunomaduro/collision": "^7.10",
		"pestphp/pest-plugin-arch": "^2.7",
		"pestphp/pest-plugin-laravel": "^2.4",
		"pestphp/pest-plugin-type-coverage": "^2.8.2",
		"phpstan/extension-installer": "^1.3.1",
		"phpstan/phpstan-deprecation-rules": "^1.2.0",
		"phpstan/phpstan-phpunit": "^1.4.0",
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^9.0"
    },
    "scripts": {
        "test": "pest"
    },
	"autoload": {
		"psr-4": {
			"Misaf\\LaravelSmsGateway\\": "src/",
            "Misaf\\LaravelSmsGateway\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Misaf\\LaraveSmsGateway\\SmsGatewayServiceProvider"
			]
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"phpstan/extension-installer": true
		}
	}
}
